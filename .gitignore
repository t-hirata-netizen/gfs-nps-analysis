# 実データ・DB・出力は Git に含めない
data/
output/
*.db
*.sqlite
*.sqlite3
# サンプル以外の Excel / CSV は含めない
*.xlsx
*.xls
*.csv
!sample_data/*.xlsx
!sample_data/*.csv
.venv/
__pycache__/
.pytest_cache/
.DS_Store

# 公開用ダッシュボードの書き出し先（公開は別リポジトリ）
site/

# クラウドの設定（プロジェクトID など）
deploy/config.sh

# Streamlit のシークレット（サービスアカウントの鍵など）
.streamlit/secrets.toml
*.json.key
service-account*.json
